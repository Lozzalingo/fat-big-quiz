generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String                   @id @default(uuid())
  slug            String                   @unique
  title           String
  mainImage       String
  price           Float                    @default(0)
  rating          Int                      @default(0)
  description     String                   @db.LongText
  manufacturer    String
  inStock         Int                      @default(1)
  categoryId      String?                  // Legacy field - kept for migration, use categories relation instead
  viewCount       Int?
  productType     ProductType              @default(PHYSICAL)
  downloadFile    String?                  @db.Text // JSON array of download files
  downloadLimit   Int?                     // Max downloads allowed per purchase
  stripeProductId String?                  // Stripe product ID
  stripePriceId   String?                  // Stripe price ID
  features        String?                  @db.LongText // JSON array of features for landing page
  videoUrl        String?                  // YouTube or video embed URL
  displayOrder    Int                      @default(0)  // Sort order for admin listing
  quizFormatId    String?                  // Reference to QuizFormat
  tags            String?                  @db.Text // JSON array of tag strings

  // Parent-variant hierarchy
  parentId        String?                  // Parent product ID (null = top-level or standalone)
  isParent        Boolean                  @default(false) // True for parent products (Fat Big Quiz, Game Shows, Whacky Wagers)
  variantLabel    String?                  // Label like "Christmas Edition", "Valentine's Special"
  eventFormat     EventFormat?             // VIRTUAL, IN_PERSON, HYBRID - how this product can be delivered

  // Events/Experiences fields (used by @lozzalingo/experiences)
  name            String?                  // Event display name (separate from shop title)
  shortDesc       String?                  @db.Text
  coverImage      String?                  // Cover/banner image filename
  category        String?                  @map("productCategory") // Event category slug
  themes          String?                  @db.Text // JSON string array of theme names
  maxGroupSize    Int?
  duration        String?                  @map("productDuration") // e.g. "2 hours"
  ticketLimit     Int?
  venue           String?                  @db.Text // JSON: { name, address, latitude, longitude, nearestStation }
  isActive        Boolean                  @default(true)

  parent          Product?                 @relation("ProductVariants", fields: [parentId], references: [id])
  variants        Product[]                @relation("ProductVariants")
  discountCodes   DiscountCodeProduct[]
  shopImages      Image[]                  @relation("ProductImages")
  legacyCategory  Category?                @relation("ProductCategory", fields: [categoryId], references: [id])
  quizFormat      QuizFormat?              @relation(fields: [quizFormatId], references: [id])
  categories      ProductCategory[]        // Many-to-many categories
  Wishlist        Wishlist[]
  customerOrders  customer_order_product[]
  purchases       Purchase[]

  // Events relations (used by @lozzalingo/experiences + events-ui)
  packages        Package[]
  images          ProductImage[]
  sections        ProductSection[]
  productThemes   ProductTheme[]
  calendarEvents  CalendarEvent[]          @relation("ProductCalendarEvents")

  @@index([categoryId], map: "Product_categoryId_fkey")
  @@index([quizFormatId])
  @@index([parentId])
}

model Purchase {
  id              String    @id @default(uuid())
  userId          String?
  email           String    // For guest purchases
  productId       String
  stripePaymentId String?
  stripeSessionId String?
  downloadToken   String?   @unique // Secure token for guest downloads
  downloadCount   Int       @default(0)
  status          String    @default("pending") // pending, completed, refunded
  createdAt       DateTime  @default(now())
  expiresAt       DateTime? // When download link expires for guests
  product         Product   @relation(fields: [productId], references: [id])
  user            User?     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([stripeSessionId])
  @@index([downloadToken])
}

model DiscountCode {
  id                 String                @id @default(uuid())
  code               String                @unique
  discountType       DiscountType
  discountValue      Float
  startDate          DateTime?
  endDate            DateTime?
  minPurchase        Int?
  maxRedemptions     Int?
  currentRedemptions Int                   @default(0)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  orders             Customer_order[]
  applicableProducts DiscountCodeProduct[]

  @@index([code])
}

model DiscountCodeProduct {
  id             String       @id @default(uuid())
  discountCodeId String
  productId      String
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, productId])
  @@index([discountCodeId])
  @@index([productId])
}

model Image {
  imageID   String  @id @default(uuid())
  productID String
  image     String
  product   Product @relation("ProductImages", fields: [productID], references: [id], onDelete: Cascade)

  @@index([productID], map: "Image_productID_fkey")
}

// === Events/Experiences models (@lozzalingo/experiences + events-ui) ===

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSection {
  id            Int      @id @default(autoincrement())
  productId     String
  title         String
  type          String   @default("text")
  content       String?  @db.Text
  listItems     String?  @db.Text
  isCollapsible Boolean  @default(true)
  displayOrder  Int      @default(0)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Package {
  id                    String      @id @default(uuid())
  productId             String
  name                  String
  slug                  String
  description           String?     @db.Text
  duration              String?
  minPlayers            Int?
  maxPlayers            Int?
  pricePerPerson        Int?
  flatPrice             Int?
  minReserve            Int?
  additionalPlayerPrice Int?
  includes              String?     @db.Text
  isActive              Boolean     @default(true)
  displayOrder          Int         @default(0)
  bookingType           BookingType @default(PRIVATE)
  product               Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, slug])
  @@index([productId])
}

model Theme {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  slug     String         @unique
  products ProductTheme[]
}

model ProductTheme {
  id        Int     @id @default(autoincrement())
  productId String
  themeId   Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  theme     Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([productId, themeId])
  @@index([productId])
  @@index([themeId])
}

model Visitor {
  id               String    @id @default(uuid())
  ip               String
  path             String?
  referrer         String?
  referrerCategory String?
  city             String?
  country          String?
  region           String?   // State/province
  latitude         Float?
  longitude        Float?
  timestamp        DateTime  @default(now())

  // Session tracking
  sessionId        String?   // Tracks user session across pages
  sessionPageCount Int?      // Pages visited in this session
  isNewVisitor     Boolean   @default(true)

  // Device & Browser info
  userAgent        String?   @db.Text
  deviceType       String?   // mobile, tablet, desktop, tv, bot
  deviceBrand      String?   // Apple, Samsung, Google, etc.
  deviceConfidence Float?    // Detection confidence 0-100
  browser          String?   // Chrome, Safari, Firefox, etc.
  browserVersion   String?
  os               String?   // Windows, macOS, iOS, Android, Linux
  osVersion        String?

  // Screen & Hardware
  screenWidth      Int?
  screenHeight     Int?
  viewportWidth    Int?
  viewportHeight   Int?
  pixelRatio       Float?
  colorDepth       Int?
  touchPoints      Int?      // Max touch points (0 = no touch)
  orientation      String?   // portrait, landscape
  hardwareCores    Int?      // CPU cores
  deviceMemory     Float?    // RAM in GB
  connectionType   String?   // 4g, 3g, wifi, etc.

  // Fingerprinting
  fingerprint      String?   // Hashed device fingerprint
  canvasHash       String?   // Canvas fingerprint
  webglHash        String?   // WebGL fingerprint

  // Bot detection
  isBot            Boolean   @default(false)
  botType          String?   // googlebot, bingbot, crawler, etc.
  jsEnabled        Boolean   @default(true)

  // Page timing
  pageLoadTime     Int?      // Page load time in ms
  timeOnPage       Int?      // Duration in seconds

  // UTM & Campaign tracking
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmContent       String?
  utmTerm          String?

  // Event tracking
  eventType        String?   // page_view, click, form_submit, etc.
  eventData        Json?     // Additional event data

  // E-commerce tracking
  productViewed    String?   // Product ID if viewing product
  addedToCart      Boolean   @default(false)
  checkoutStarted  Boolean   @default(false)
  purchaseComplete Boolean   @default(false)
  orderValue       Float?

  // Attribution
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])

  // Legacy field
  actions          Json?     // Store actions as JSON array

  @@index([timestamp])
  @@index([sessionId])
  @@index([fingerprint])
  @@index([country])
  @@index([eventType])
  @@index([isBot])
  @@index([userId])
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  password              String?
  role                  String?        @default("user")
  avatar                String?
  bio                   String?
  firstName             String?
  lastName              String?
  createdAt             DateTime       @default(now())
  userName              String?        @unique
  stripeCustomerId      String?        // Stripe customer ID for subscriptions
  stripeSubscriptionId  String?        // Active Stripe subscription ID
  subscriptionStatus    String?        // active, cancelled, past_due, trialing, none
  subscriptionExpiresAt DateTime?      // When current billing period ends
  BlogPosts             BlogPost[]     @relation("AuthorPosts")
  Comments              Comment[]
  purchases             Purchase[]
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")
  settings              Settings[]     @relation("UserSettings")
  votes                 Vote[]         @relation("UserVotes")
  Wishlist              Wishlist[]
  visitors              Visitor[]
}

model Settings {
  id        Int      @id @default(autoincrement())
  userId    String
  orders    Boolean  @default(true)
  products  Boolean  @default(true)
  blog      Boolean  @default(true)
  users     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserSettings", fields: [userId], references: [id])

  @@index([userId], map: "Settings_userId_fkey")
}

model Notification {
  id          String   @id @default(uuid())
  type        String
  recipientId String
  senderId    String?
  entityId    String
  entityType  String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  recipient   User     @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User?    @relation("SentNotifications", fields: [senderId], references: [id])

  @@index([recipientId], map: "Notification_recipientId_fkey")
  @@index([senderId], map: "Notification_senderId_fkey")
}

model Customer_order {
  id             String                   @id @default(uuid())
  phone          String
  email          String
  company        String
  address        String
  apartment      String
  postalCode     String
  dateTime       DateTime?                @default(now())
  status         String
  city           String
  country        String
  orderNotice    String?
  total          Int
  firstName      String
  lastName       String
  discountCodeId String?
  discountCode   DiscountCode?            @relation(fields: [discountCodeId], references: [id])
  products       customer_order_product[]

  @@index([discountCodeId], map: "Customer_order_discountCodeId_fkey")
}

model customer_order_product {
  id              String         @id @default(uuid())
  customerOrderId String
  productId       String
  quantity        Int
  customerOrder   Customer_order @relation(fields: [customerOrderId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])

  @@index([customerOrderId], map: "customer_order_product_customerOrderId_fkey")
  @@index([productId], map: "customer_order_product_productId_fkey")
}

model Category {
  id                String            @id @default(uuid())
  name              String
  coverImage        String?
  metaDescription   String?
  metaTitle         String?
  type              CategoryType      @default(PRODUCT)
  posts             BlogPost[]        @relation("BlogCategory")
  products          Product[]         @relation("ProductCategory")
  productCategories ProductCategory[] // Many-to-many with products
}

model QuizFormat {
  id              String    @id @default(uuid())
  name            String    @unique // URL-friendly slug: "basic-quiz", "music-quiz"
  displayName     String             // Display name: "Basic Quiz", "Music Quiz"
  description     String?   @db.LongText
  explainerImages String?   @db.LongText // JSON array of image filenames
  displayOrder    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
}

// ─── QUIZ DATABASE ─────────────────────────────────────────────────────────────

model QuizCategory {
  id            String            @id @default(uuid())
  name          String            @unique
  slug          String            @unique
  displayOrder  Int               @default(0)
  questions     QuizQuestion[]
  subCategories QuizSubCategory[] @relation("CategorySubCategories")
}

model QuizSubCategory {
  id           String         @id @default(uuid())
  name         String         @unique
  slug         String         @unique
  categoryId   String?
  displayOrder Int            @default(0)
  category     QuizCategory?  @relation("CategorySubCategories", fields: [categoryId], references: [id])
  questions    QuizQuestion[]

  @@index([categoryId])
}

// Add reverse relation on QuizCategory
// (handled via the @relation name above)

model QuizCountry {
  id           String         @id @default(uuid())
  name         String         @unique
  code         String         @unique // e.g. "UK", "US", "AU", "WORLD"
  displayOrder Int            @default(0)
  questions    QuizQuestion[]
}

model QuizTheme {
  id           String         @id @default(uuid())
  name         String         @unique
  slug         String         @unique
  monthsActive String?        // JSON array of month numbers, e.g. "[0,1]" for Jan-Feb
  displayOrder Int            @default(0)
  questions    QuizQuestion[]
}

model QuizSource {
  id            String         @id @default(uuid())
  name          String         @unique
  slug          String         @unique
  url           String?
  lastRunAt     DateTime?
  lastRunStatus String?        // "success", "error", "running"
  lastRunCount  Int?           // Questions imported in last run
  displayOrder  Int            @default(0)
  questions     QuizQuestion[]
}

model QuizQuestion {
  id               String             @id @default(uuid())
  questionText     String             @db.Text
  questionOriginal String?            @db.Text // Raw scraped text before rewriting
  answerText       String             @db.Text
  answerOriginal   String?            @db.Text // Raw scraped answer
  options          String?            @db.Text // JSON: [{"label":"A","text":"Paris"},...]
  explanation      String?            @db.Text

  difficulty       QuestionDifficulty @default(MEDIUM)
  questionType     QuestionType       @default(MULTIPLE_CHOICE)
  status           QuestionStatus     @default(UNVERIFIED)

  categoryId       String
  subCategoryId    String?
  countryId        String
  themeId          String
  sourceId         String

  sourceUrl        String?            // URL of the original quiz page
  publishedDate    DateTime?          // When the original quiz was published
  scrapedDate      DateTime?          // When it was scraped
  year             Int?               // Derived from publishedDate for filtering
  week             Int?               // Week number from scraper system

  // Scraper traceability
  externalId       String?   @unique  // Scraper question ID for duplicate detection

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  category         QuizCategory    @relation(fields: [categoryId], references: [id])
  subCategory      QuizSubCategory? @relation(fields: [subCategoryId], references: [id])
  country          QuizCountry     @relation(fields: [countryId], references: [id])
  theme            QuizTheme       @relation(fields: [themeId], references: [id])
  source           QuizSource      @relation(fields: [sourceId], references: [id])
  feedback         QuizQuestionFeedback[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([countryId])
  @@index([themeId])
  @@index([sourceId])
  @@index([status])
  @@index([year])
  @@index([difficulty])
  @@index([questionType])
  @@index([publishedDate])
  @@index([createdAt])
}

model QuizQuestionFeedback {
  id           String       @id @default(uuid())
  questionId   String
  vote         QuizVoteType
  fingerprint  String       // Browser-generated session ID for anonymous voting
  createdAt    DateTime     @default(now())

  question     QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, fingerprint])
  @@index([questionId])
  @@index([fingerprint])
}

enum QuizVoteType {
  GOOD
  BAD
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN_ANSWER
  FILL_IN_THE_BLANKS
  NAME_ANY
  ORDER_THESE
  WHOS_AT_POSITION
  WHAT_POSITION
  MISSING_SLOT
  TOP_OR_BOTTOM_HALF
  WHATS_BETWEEN
  HOW_FAR_APART
  HIGHEST_RANKED
  COMPLETE_THE_LIST
  HIGHER_OR_LOWER
  UP_OR_DOWN
  WHICH_IS_HIGHER
  WORTH_MORE
  SPOT_THE_FAKE
  SWAP
  FINISH_THE_LYRIC
  MOST_WEEKS_AT_NUMBER_ONE
  MOST_STREAMS
  MOVIE_TAGLINE
  ROTTEN_TOMATOES_SCORE
  NAME_THE_GAME
  FAKE_NEWS
  MISSING_WORDS
  MATCH_THE_COMMENT
  MOST_UPVOTES
  BEST_PERFORMER
  WHAT_PRICE
  EXCHANGE_RATE
  BIGGEST_GAIN_LOSS
}

enum QuestionStatus {
  UNVERIFIED
  VERIFIED
  FLAGGED
}

model ProductCategory {
  id         String   @id @default(uuid())
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model HomepageCard {
  id           String          @id @default(uuid())
  title        String
  description  String          @db.Text
  price        String          // Flexible: "From £15", "Free", "£4.99/mo"
  href         String
  image        String?         // CDN filename
  badge        String?
  cardType     HomepageCardType @default(DOWNLOAD)
  displayOrder Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum HomepageCardType {
  DOWNLOAD
  SUBSCRIPTION
  EVENT
  APP
  FREE
}

// Global bonus files included with every purchase
model GlobalDownloadFile {
  id           String   @id @default(uuid())
  title        String                      // Display name (e.g., "Meet Laurence")
  description  String?  @db.Text           // Optional description
  fileName     String                      // CDN filename
  displayOrder Int      @default(0)        // Sort order
  isActive     Boolean  @default(true)     // Can disable without deleting
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Wishlist {
  id        String  @id @default(uuid())
  productId String
  userId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId], map: "Wishlist_productId_fkey")
  @@index([userId], map: "Wishlist_userId_fkey")
}

model Subscriber {
  id            String                  @id @default(uuid())
  email         String                  @unique
  firstName     String?
  lastName      String?
  source        String?                 // Short tag: "sign-up", "popup", "quiz-pack", "quiz-database", "app"
  sourcePath    String?                 // Full URL path: "/sign-up", "/quiz-database"
  subscribedAt  DateTime                @default(now())
  optIn         Boolean                 @default(true)
  confirmations SubscriberConfirmation[]

  @@index([source])
}

model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  content         String    @db.LongText
  excerpt         String?   @db.LongText
  coverImage      String?
  published       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  metaTitle       String?
  metaDescription String?
  authorId        String
  categoryId      String
  viewCount       Int?
  author          User      @relation("AuthorPosts", fields: [authorId], references: [id], onDelete: Cascade)
  category        Category  @relation("BlogCategory", fields: [categoryId], references: [id])
  comments        Comment[]
  tags            Tag[]     @relation("PostTags")

  @@index([authorId], map: "BlogPost_authorId_fkey")
  @@index([categoryId], map: "BlogPost_categoryId_fkey")
  @@index([published, createdAt])
}

model Comment {
  id        String    @id @default(uuid())
  message   String
  createdAt DateTime  @default(now())
  userId    String
  postId    String
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  post      BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     Vote[]

  @@index([postId], map: "Comment_postId_fkey")
  @@index([userId], map: "Comment_userId_fkey")
  @@index([parentId], map: "Comment_parentId_fkey")
}

model Vote {
  id        String   @id @default(uuid())
  type      String
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation("UserVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId], map: "Vote_commentId_fkey")
  @@index([userId], map: "Vote_userId_fkey")
}

model Tag {
  id    String     @id @default(uuid())
  name  String     @unique
  posts BlogPost[] @relation("PostTags")
}

// ─── CALENDAR & SCHEDULING ──────────────────────────────────────────────────────

model CalendarEvent {
  id              String          @id @default(uuid())
  title           String
  description     String?         @db.Text
  startTime       DateTime
  endTime         DateTime
  timezone        String          @default("Europe/London")

  // Link to product
  productId       String?
  product         Product?        @relation("ProductCalendarEvents", fields: [productId], references: [id])

  // Link to event product (for events-ui)
  eventProductId  String?
  eventProduct    EventProduct?   @relation("EventProductCalendarEvents", fields: [eventProductId], references: [id])

  // Capacity
  maxCapacity     Int?
  currentBookings Int             @default(0)

  // Recurrence
  isRecurring     Boolean         @default(false)
  recurrenceRule  String?         // RRULE string (RFC 5545)
  parentEventId   String?         // Link to recurring parent

  // Location
  locationId      String?
  locationName    String?
  isVirtual       Boolean         @default(false)
  meetingUrl      String?         // Zoom/Teams link

  // Status
  status          CalendarStatus  @default(SCHEDULED)
  isPublic        Boolean         @default(true)

  // Slot management (@lozzalingo/calendar slots)
  slotStatus         String?   @default("AVAILABLE")
  heldUntil          DateTime?
  heldByBookingId    String?
  blockedByBookingId String?
  externalCalendarId String?
  externalSource     String?
  supplierId         String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bookings        CalendarBooking[]

  @@index([startTime])
  @@index([productId])
  @@index([eventProductId])
  @@index([status])
}

model CalendarBooking {
  id              String               @id @default(uuid())
  calendarEventId String
  bookingId       String?
  customerName    String
  customerEmail   String
  groupSize       Int
  status          CalendarBookingStatus @default(PENDING)
  createdAt       DateTime             @default(now())

  calendarEvent   CalendarEvent        @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  @@index([calendarEventId])
  @@index([customerEmail])
}

enum CalendarStatus {
  DRAFT
  SCHEDULED
  LIVE
  FULL
  COMPLETED
  CANCELLED
}

enum CalendarBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CategoryType {
  PRODUCT
  BLOG
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductType {
  PHYSICAL
  DIGITAL_DOWNLOAD
  SUBSCRIPTION
  EVENT
}

enum EventFormat {
  VIRTUAL
  IN_PERSON
  HYBRID
}

// ─── UNIFIED SALES TRACKING ────────────────────────────────────────────────────

enum SalesChannel {
  WEBSITE
  ETSY
}

enum SaleStatus {
  PENDING      // Checkout started (website) - enables abandoned cart tracking
  PAID         // Payment confirmed
  COMPLETED    // Fully fulfilled (shipped or downloaded)
  REFUNDED
  CANCELLED
}

model Sale {
  id                String       @id @default(uuid())
  channel           SalesChannel

  // External IDs (duplicate detection)
  externalReceiptId String?      @unique  // Etsy receipt ID or Stripe session ID
  stripeSessionId   String?               // Stripe checkout session (website sales)
  stripePaymentId   String?               // Stripe payment intent

  // Buyer info
  buyerEmail        String
  buyerName         String?
  buyerPhone        String?
  buyerUserId       String?               // Etsy buyer user ID or local user ID
  paymentMethod     String?               // "card", "paypal", etc.

  // Financials (integers in pence - minor currency units)
  subtotal          Int          @default(0)
  shippingCost      Int          @default(0)
  shippingDiscount  Int          @default(0)
  taxTotal          Int          @default(0)
  vatTotal          Int          @default(0)
  discountTotal     Int          @default(0)
  grandTotal        Int          @default(0)
  processingFees    Int          @default(0)  // Card processing fees (Etsy/Stripe)
  orderNet          Int          @default(0)  // Grand total minus fees - what you actually receive
  currency          String       @default("GBP")

  // Buyer geography
  shippingLine1     String?
  shippingLine2     String?
  shippingCity      String?
  shippingState     String?
  shippingPostalCode String?
  shippingCountry   String?               // Full name: "United Kingdom"
  shippingCountryISO String?              // ISO code: "GB"

  // Status and timing
  status            SaleStatus   @default(PENDING)
  paidAt            DateTime?
  completedAt       DateTime?

  // CRM link
  customerId        String?

  // Raw payload for debugging
  rawPayload        String?      @db.LongText

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  items             SaleItem[]

  @@index([channel])
  @@index([buyerEmail])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([stripeSessionId])
}

model SaleItem {
  id                    String   @id @default(uuid())
  saleId                String

  // External IDs
  externalTransactionId String?  // Etsy transaction ID
  externalListingId     String?  // Etsy listing ID
  externalProductId     String?  // Etsy product ID

  // Local product link (nullable - only set if matched to a local Product)
  productId             String?

  // Denormalised product info (always stored)
  title                 String
  description           String?  @db.Text
  sku                   String?
  quantity              Int      @default(1)
  unitPrice             Int      @default(0)  // In pence
  currency              String   @default("GBP")
  isDigital             Boolean  @default(false)
  variations            String?  @db.Text     // JSON array of variations

  // Per-item discounts and tax
  couponCode            String?
  couponDiscount        Int      @default(0)  // In pence
  vatAmount             Int      @default(0)  // VAT paid by buyer on this item, in pence

  sale                  Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([externalTransactionId])
  @@index([productId])
}

// ====== Shared Package Models ======

// @lozzalingo/logging
model AppLog {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  level       String
  source      String
  message     String   @db.Text
  details     String?  @db.Text
  ipAddress   String?
  userAgent   String?  @db.Text
  requestPath String?
  userId      String?
  @@index([timestamp])
  @@index([level])
  @@index([source])
}

// @lozzalingo/subscribers - popup config
model SubscriberPopupConfig {
  id        Int      @id @default(1)
  config    String   @db.Text
  updatedAt DateTime @updatedAt
}

// @lozzalingo/settings (encrypted)
model Setting {
  id          Int      @id @default(autoincrement())
  category    String
  key         String   @unique
  value       String?  @db.Text
  isSecret    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([category])
  @@index([key])
}

// @lozzalingo/auth
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([token])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([token])
}

// @lozzalingo/orders (shared)
model Order {
  id                 Int         @id @default(autoincrement())
  orderNumber        String      @unique
  customerEmail      String
  customerName       String?
  totalAmount        Int
  currency           String      @default("gbp")
  status             String      @default("paid")
  stripeSessionId    String?
  shippingName       String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingPostalCode String?
  shippingCountry    String?
  trackingNumber     String?
  carrier            String?
  notes              String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
  @@index([customerEmail])
  @@index([status])
}

model OrderItem {
  id          Int    @id @default(autoincrement())
  orderId     Int
  productName String
  quantity    Int    @default(1)
  unitPrice   Int
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// @lozzalingo/merchandise (shared)
model MerchProduct {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?  @db.Text
  price          Int
  stockQuantity  Int      @default(0)
  isActive       Boolean  @default(true)
  isPreorder     Boolean  @default(false)
  limitedEdition Boolean  @default(false)
  imageUrls      String   @db.Text
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([isActive])
}

model Campaign {
  id        String    @id @default(uuid())
  subject   String
  heading   String?
  body      String    @db.LongText
  ctaUrl    String?
  ctaText   String?
  status    String    @default("draft")
  sentCount Int       @default(0)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SubscriberConfirmation {
  id           String   @id @default(uuid())
  customerId   String?
  subscriberId String?                  // Legacy: kept during migration, will be removed
  token        String   @unique
  expiresAt    DateTime
  confirmed    Boolean  @default(false)
  createdAt    DateTime @default(now())
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriber   Subscriber? @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  @@index([customerId])
  @@index([subscriberId])
}

// === NEW: Booking system (@lozzalingo/bookings) ===

model Booking {
  id                String        @id @default(uuid())
  bookingNumber     String        @unique
  bookingType       BookingType   @default(PRIVATE)
  status            BookingStatus_New @default(ENQUIRY)

  customerName      String
  customerEmail     String
  customerPhone     String?
  companyName        String?
  message            String?       @db.Text

  customerId        String?
  experienceId      String?
  productId         String?
  packageId         String?
  eventDate         DateTime?
  eventTime         String?
  duration          String?
  timeBlocking      String?
  groupSize         Int
  specialRequests   String?       @db.Text

  quotedPrice       Int?
  depositAmount     Int?
  totalAmount       Int?
  totalPaid         Int           @default(0)

  stripeSessionId   String?
  stripePaymentId   String?

  calendarEventId   String?
  pencilExpiresAt   DateTime?

  adminNotes        String?       @db.Text
  notes             String?       @db.Text
  source            String?       @default("website")
  assignedTo        String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum BookingType {
  PRIVATE
  PUBLIC
  PLAY_TODAY
}

enum BookingStatus_New {
  ENQUIRY
  QUOTED
  INVOICE_SENT
  PENCILLED
  DEPOSIT_PAID
  PAID
  CONFIRMED
  COMPLETED
  CANCELLED
  LOST
}

// === CRM (@lozzalingo/crm) ===

model Customer {
  id                  String         @id @default(uuid())
  customerNumber      String?        @unique // Human-readable: #FBQ0001
  fingerprint         String?                 // Links anonymous Visitor data
  firstName           String
  lastName            String
  email               String         @unique
  phone               String?
  company             String?
  jobTitle            String?
  dateOfBirth         DateTime?
  country             String?
  region              String?
  lat                 Float?
  lng                 Float?
  ipAddress           String?
  source              String?                 // First-touch: "website", "referral", "etsy"
  status              CustomerStatus @default(ACTIVE)
  marketingOptIn      Boolean        @default(false) // Double opt-in confirmed
  totalSpent          Int            @default(0)     // Cached, pence
  totalBookings       Int            @default(0)     // Cached count
  lastActivityAt      DateTime?                      // Last engagement of any kind
  referralName        String?
  referralEmail       String?
  linkedinUrl         String?
  instagramHandle     String?
  websiteUrl          String?
  notes               String?        @db.Text
  termsAcceptedAt     DateTime?
  privacyAcceptedAt   DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  activities              CustomerActivity[]
  marketingPreferences    MarketingPreference[]
  campaignSends           CrmCampaignSend[]
  subscriberConfirmations SubscriberConfirmation[]
  score                   CustomerScore?

  @@index([email])
  @@index([source])
  @@index([status])
  @@index([fingerprint])
  @@index([customerNumber])
}

enum CustomerStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

model CustomerActivity {
  id              String       @id @default(uuid())
  customerId      String
  type            ActivityType
  source          String?                  // "website", "etsy", "app", "public-game"
  channel         String?                  // "Website Sign Up", "Etsy Store", "BucketRace Games"
  productRef      String?                  // ID from site-specific product table
  productModel    String?                  // "Event", "Product", "MerchProduct"
  productName     String?                  // Denormalised for display without joins
  productCategory String?                  // "Scavenger Hunt", "Printable Quiz", "Live Show"
  platform        String?                  // "Virtual", "Real-World", "Hybrid"
  groupType       String?                  // "Corporate", "Private", "Public"
  audience        String?                  // "Adult", "Children", "Mixed"
  location        String?
  region          String?
  country         String?
  teamName        String?
  eventDate       DateTime?
  metadata        String?      @db.Text    // JSON for anything else
  createdAt       DateTime     @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
}

enum ActivityType {
  GAME_PLAYED
  PRODUCT_USED
  WEBSITE_VISIT
  APP_INTERACTION
  FREE_CONTENT
  ENQUIRY
  SIGNUP
}

model CustomerScore {
  id          String   @id @default(uuid())
  customerId  String   @unique
  score       Int      @default(0)
  breakdown   String   @db.Text // JSON: { profile: 25, purchase: 40, engagement: 18, decay: -10 }
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([score])
}

model MarketingPreference {
  id          String   @id @default(uuid())
  customerId  String
  preference  String                   // "Virtual", "Real World", "Fat Big Quiz", etc.
  optedIn     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, preference])
  @@index([customerId])
}

// CRM campaign tracking (separate from the email content Campaign model)
model CrmCampaign {
  id           String   @id @default(uuid())
  name         String
  subject      String
  sentAt       DateTime?
  totalSent    Int      @default(0)
  totalOpened  Int      @default(0)
  totalClicked Int      @default(0)
  createdAt    DateTime @default(now())

  sends CrmCampaignSend[]
}

model CrmCampaignSend {
  id          String    @id @default(uuid())
  campaignId  String
  customerId  String
  sentAt      DateTime  @default(now())
  opened      Boolean   @default(false)
  openedAt    DateTime?
  clicked     Boolean   @default(false)
  clickedAt   DateTime?

  campaign CrmCampaign @relation(fields: [campaignId], references: [id])
  customer Customer    @relation(fields: [customerId], references: [id])

  @@index([campaignId])
  @@index([customerId])
  @@index([sentAt])
}

// === Bookings: Invoices ===

model Invoice {
  id                String        @id @default(uuid())
  bookingId         String
  lineItems         String        @db.Text
  totalAmountPence  Int
  description       String?
  status            InvoiceStatus @default(DRAFT)
  stripeInvoiceId   String?
  invoiceNumber     String?
  hostedInvoiceUrl  String?       @db.Text
  sentAt            DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([bookingId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
  CANCELLED
}

// === Event Products (parallel to e-commerce Product, for @lozzalingo/events-ui) ===

model EventProduct {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String   @db.Text
  shortDesc    String?  @db.Text
  coverImage   String?
  category     String?
  tags         String?  @db.Text // JSON array of category tag slugs for multi-tagging
  format       String? // e.g. "in-person", "virtual", "outdoors", "indoors", "hybrid"
  themes       String?  @db.Text
  maxGroupSize Int?
  venue        String?  @db.Text
  duration     String?
  ticketLimit  Int?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  packages       EventPackage[]
  images         EventProductImage[]
  sections       EventProductSection[]
  calendarEvents CalendarEvent[]       @relation("EventProductCalendarEvents")

  @@index([isActive])
  @@index([category])
}

model EventProductSection {
  id            Int     @id @default(autoincrement())
  productId     String
  title         String
  type          String  @default("text")
  content       String? @db.Text
  listItems     String? @db.Text
  isCollapsible Boolean @default(true)
  displayOrder  Int     @default(0)

  product EventProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model EventProductImage {
  id        Int     @id @default(autoincrement())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product EventProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model EventPackage {
  id                    String      @id @default(uuid())
  productId             String
  name                  String
  slug                  String
  description           String?     @db.Text
  duration              String?
  minPlayers            Int?
  maxPlayers            Int?
  pricePerPerson        Int?
  flatPrice             Int?
  minReserve            Int?
  additionalPlayerPrice Int?
  includes              String?     @db.Text
  isActive              Boolean     @default(true)
  displayOrder          Int         @default(0)
  bookingType           BookingType
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  product EventProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, slug])
  @@index([bookingType])
  @@index([isActive])
}

// === NEW: Outreach system (@lozzalingo/outreach) ===

model OutreachLog {
  id              String         @id @default(uuid())
  trigger         String
  recipientEmail  String
  subject         String
  status          OutreachStatus @default(SENT)
  error           String?        @db.Text
  bookingId       String?
  purchaseId      String?
  sentAt          DateTime       @default(now())
  createdAt       DateTime       @default(now())
}

model OutreachSchedule {
  id              String          @id @default(uuid())
  trigger         String
  recipientEmail  String
  bookingId       String?
  scheduledFor    DateTime
  status          ScheduleStatus  @default(PENDING)
  processedAt     DateTime?
  error           String?         @db.Text
  createdAt       DateTime       @default(now())
}

enum OutreachStatus {
  SENT
  FAILED
}

enum ScheduleStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}
