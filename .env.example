# Fat Big Quiz - Environment Variables
# Copy to .env on the server and fill in values

# Database
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Auth (auth.laurence.computer)
AUTH_SERVICE_URL=https://auth.laurence.computer
AUTH_JWT_SECRET=
AUTH_SITE_API_KEY=
AUTH_SITE_ID=fat-big-quiz

# DigitalOcean Spaces
DO_SPACES_KEY=
DO_SPACES_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_REPLY_TO=

# Downloads (REQUIRED - used to sign download tokens)
DOWNLOAD_SECRET=

# Admin (used by @lozzalingo/core)
ADMIN_EMAIL=
ADMIN_API_KEY=
ADMIN_SECRET=

# Environment
NODE_ENV=production

